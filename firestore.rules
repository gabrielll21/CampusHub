rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update: if isUser(userId);
      allow delete: if false;

      match /favorites/{eventId} {
        allow read, delete: if isUser(userId);

        allow create, update: if isUser(userId)
          && request.resource.data.keys().hasOnly([
            'eventId', 'userId', 'createdAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.userId is string
          && request.resource.data.eventId is string;
      }
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /comments/{commentId} {
        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.resource.data.keys().hasOnly([
            'eventId', 'authorId', 'authorName', 'content',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.authorId is string
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0;

        allow update: if isSignedIn()
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['content', 'updatedAt'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0;

        allow delete: if isSignedIn()
          && resource.data.authorId == request.auth.uid;
      }

      match /ratings/{userId} {
        allow read: if isSignedIn();

        allow create: if canWriteRating(userId, eventId)
          && request.resource.data.keys().hasOnly([
            'userId', 'eventId', 'score', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5;

        allow update: if canWriteRating(userId, eventId)
          && resource.data.userId == request.auth.uid
          && resource.data.eventId == eventId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['score', 'updatedAt'])
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5;

        allow delete: if false;

        function hasDeterministicRegistration(ratingEventId) {
          return exists(
              /databases/$(database)/documents/registrations/$(request.auth.uid + "_" + ratingEventId)
            )
            && get(
              /databases/$(database)/documents/registrations/$(request.auth.uid + "_" + ratingEventId)
            ).data.userId == request.auth.uid
            && get(
              /databases/$(database)/documents/registrations/$(request.auth.uid + "_" + ratingEventId)
            ).data.eventId == ratingEventId;
        }

        // Temporariamente, a autorização não valida o encerramento do evento.
        // startsAt <= request.time indica que o evento começou, não que terminou.
        // A solução correta exige events/{eventId}.endsAt (Timestamp) e uma
        // condição futura endsAt <= request.time. O campo legado date não é
        // interpretado pelas Rules.
        function canWriteRating(ratingUserId, ratingEventId) {
          return isSignedIn()
            && request.auth.uid == ratingUserId
            && hasDeterministicRegistration(ratingEventId);
        }
      }
    }

    match /registrations/{registrationId} {
      allow get: if isSignedIn()
        && (
          (
            exists(
              /databases/$(database)/documents/registrations/$(registrationId)
            )
            && get(
              /databases/$(database)/documents/registrations/$(registrationId)
            ).data.userId == request.auth.uid
          )
          || (
            !exists(
              /databases/$(database)/documents/registrations/$(registrationId)
            )
            && registrationId.matches('^' + request.auth.uid + '_.*$')
          )
        );

      allow list: if isSignedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'userId', 'eventId', 'registeredAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.eventId is string
        && request.resource.data.eventId.size() > 0
        && registrationId == request.auth.uid + "_" + request.resource.data.eventId;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.eventId == resource.data.eventId
        && registrationId == request.auth.uid + "_" + request.resource.data.eventId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['registeredAt']);

      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
